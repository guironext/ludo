{
  "name": "ludo-poky",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate-data": "node --env-file-if-exists=.env scripts/migrate-sqlite-to-postgres.mjs",
